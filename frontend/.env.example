# Default local development uses the Vite proxy:
# frontend /api/v1 -> backend http://localhost:8080/api/v1
# Leave this unset for the proxy path, or set it for direct API calls.
# VITE_API_BASE_URL=http://localhost:8080/api/v1

# Feature flags are parsed by the frontend as booleans.
# Accepted values: true, false, 1, 0, yes, no, on, off.
VITE_FEATURE_AUTH=false
VITE_FEATURE_AI=false
VITE_FEATURE_PAYMENTS=false
VITE_FEATURE_MARKETPLACE=false
